# Single-owner developer preview. Never put these in NEXT_PUBLIC_* variables.
# Generate FABLEGRAIN_ADMIN_TOKEN with at least 32 random characters.
FABLEGRAIN_ADMIN_TOKEN=
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=
# Explicit comma-separated toolkit allowlist; use exact slugs from Composio.
COMPOSIO_TOOLKITS=

# Optional single image tool over MCP. Use the exact toolkit/tool and prompt field from its official schema.
COMPOSIO_MEDIA_TOOLKIT=
COMPOSIO_MEDIA_TOOL=
COMPOSIO_MEDIA_PROMPT_FIELD=prompt
COMPOSIO_MEDIA_DEFAULT_ARGS={}
# Exact dot-separated paths in returned structuredContent or JSON text, e.g. data.images.0.url
COMPOSIO_MEDIA_OUTPUT_PATH=
COMPOSIO_MEDIA_JOB_PATH=
# Comma-separated exact HTTPS image CDN hostnames (no wildcards)
COMPOSIO_MEDIA_OUTPUT_HOSTS=
