# Single-owner developer preview. Never put these in NEXT_PUBLIC_* variables.
# Generate FABLEGRAIN_ADMIN_TOKEN with at least 32 random characters.
FABLEGRAIN_ADMIN_TOKEN=
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=
# Explicit comma-separated toolkit allowlist; use exact slugs from Composio.
COMPOSIO_TOOLKITS=
